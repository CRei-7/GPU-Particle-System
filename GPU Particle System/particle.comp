#version 430 core
layout(local_size_x = 64) in;

struct Particle {
    vec4 position;  // xyz: position, w: size
    vec4 velocity;  // xyz: velocity, w: burst flag
    vec4 color;     // rgba: color
    float life;
    float maxLife;
    vec2 padding;
};

struct EmitterConfig {
    vec4 position;
    vec4 direction;
    vec4 startColor;
    vec4 endColor;
    float size;
    float speed;
    float speedVariation;
    float spread;
    float particleLifetime;
    float particleLifetimeVariation;
    float spawnRate;    // particles per second
    int emitterType;    // 0 = continuous, 1 = burst
    float deltaTime;
    int burstCount;     // number of particles in a burst
    vec2 padding;
};

layout(std430, binding = 0) buffer ParticleBuffer {// Particle buffer
    Particle particles[];
};

layout(std430, binding = 1) buffer ParticleCountBuffer {
    uint particleCount; //current active particle count
    uint freeListHead; //index of the head of the free list
};

layout(std430, binding = 2) buffer FreeListBuffer {
    int freeList[];
};

layout(std430, binding = 4) buffer BurstBuffer {
    uint burstParticlesToSpawn;    // Counter for burst particles to spawn this frame
    vec4 burstPositions[10000];    // Positions where bursts should occur
};

layout(std140, binding = 0) uniform EmitterUniform {
    EmitterConfig config;
};

uniform float gravity;
uniform uint maxParticles;

const float PI = 3.14159265359;
const uint SEED_BASE = 42u;

//GPU does not have a built-in random number generator, so we implement a simple hash-based random number generator for deterministic randomness based on a seed.
//Bob Jenkin's hash-based random number generator
uint hash(uint x) {
    x += (x << 10u);
    x ^= (x >> 6u);
    x += (x << 3u);
    x ^= (x >> 11u);
    x += (x << 15u);
    return x;
}

float randomFloat(uint seed, float min, float max) {
    uint h = hash(seed);
    float random = float(h) / float(0xffffffffU); //normalize to [0,1]
    return min + random * (max - min);
}

vec3 randomSphereDirection(uint seed) {
    float theta = randomFloat(hash(seed + 1u), 0.0, 2.0 * PI);
    float phi = acos(randomFloat(hash(seed + 2u), -1.0, 1.0));
    
    return vec3(
        sin(phi) * cos(theta),
        sin(phi) * sin(theta),
        cos(phi)
    );
}

void main() {
    uint index = gl_GlobalInvocationID.x;
    
    if (index >= maxParticles) return;
    
    Particle p = particles[index];

    if (p.maxLife <= 0.0) return;
    
    if (p.life > 0.0) {
        p.position.xyz += p.velocity.xyz * config.deltaTime;
        p.velocity.y -= gravity * config.deltaTime;
        p.life -= config.deltaTime;
        
        float lifeRatio = clamp(p.life / p.maxLife, 0.0, 1.0);
        p.color = mix(config.endColor, config.startColor, lifeRatio);//fades the color from startColor to endColor
    }
    
    if (p.life <= 0.0 && p.velocity.w == 1.0) {
        p.velocity.w = 0.0; // Clear burst flag to prevent re-triggering
        
        // Allocates this index for burst spawning
        int burstCount = max(config.burstCount, 0);

        uint burstIndex = atomicAdd(burstParticlesToSpawn, uint(burstCount));
        
        if (burstIndex + uint(burstCount) <= 10000u) {
            for (int i = 0; i < burstCount; ++i) {
                burstPositions[burstIndex + uint(i)] = vec4(p.position.xyz, 0.0);
            }
        }
    }
    
    // Release dead particles
    if (p.life <= 0.0 && p.maxLife > 0.0) {
        p.maxLife = -1.0; // Mark as free
        uint slot = atomicAdd(freeListHead, 1u);
        if(slot < maxParticles){
            freeList[slot] = int(index);
            atomicAdd(particleCount, uint(-1));
        }
        else{
            atomicAdd(freeListHead, uint(-1)); // Revert increment if out of bounds
        }
    }
    
    particles[index] = p;
}
