#version 430 core
layout(local_size_x = 64) in;

struct Particle {
    vec4 position;  // xyz: position, w: size
    vec4 velocity;  // xyz: velocity, w: burst flag
    vec4 color;     // rgba: color
    float life;
    float maxLife;
    vec2 flags; // Using this as flags, x = 1 (immortal), y = unused
};

struct EmitterConfig {
    vec4 position;
    vec4 direction;
    vec4 startColor;
    vec4 endColor;
    float size;
    float speed;
    float speedVariation;
    float spread;
    float particleLifetime;
    float particleLifetimeVariation;
    float spawnRate;    // particles per second
    int emitterType;    // 0 = continuous, 1 = burst
    float deltaTime;
    int burstCount;     // number of particles in a burst
    vec2 padding;
};

layout(std430, binding = 0) buffer ParticleBuffer {// Particle buffer
    Particle particles[];
};

layout(std430, binding = 1) buffer ParticleCountBuffer {
    uint particleCount; //current active particle count
    uint freeListHead; //index of the head of the free list
};

layout(std430, binding = 2) buffer FreeListBuffer {
    int freeList[];
};

layout(std430, binding = 4) buffer BurstBuffer {
    uint burstParticlesToSpawn;    // Counter for burst particles to spawn this frame
    vec4 burstPositions[10000];    // Positions where bursts should occur
};

layout(std140, binding = 0) uniform EmitterUniform {
    EmitterConfig config;
};

uniform float gravity;
uniform uint maxParticles;
uniform bool shapeRotationEnabled;
uniform float angularVelocity;
uniform int motionEnabled; 
uniform float hollowSize; // Size of the hollow region for shape generation

const float PI = 3.14159265359;
const uint SEED_BASE = 42u;

//GPU does not have a built-in random number generator, so we implement a simple hash-based random number generator for deterministic randomness based on a seed.
//Bob Jenkin's hash-based random number generator
uint hash(uint x) {
    x += (x << 10u);
    x ^= (x >> 6u);
    x += (x << 3u);
    x ^= (x >> 11u);
    x += (x << 15u);
    return x;
}

float randomFloat(uint seed, float min, float max) {
    uint h = hash(seed);
    float random = float(h) / float(0xffffffffU); //normalize to [0,1]
    return min + random * (max - min);
}

vec3 randomSphereDirection(uint seed) {
    float theta = randomFloat(hash(seed + 1u), 0.0, 2.0 * PI);
    float phi = acos(randomFloat(hash(seed + 2u), -1.0, 1.0));
    
    return vec3(
        sin(phi) * cos(theta),
        sin(phi) * sin(theta),
        cos(phi)
    );
}

void confineSphere(inout vec3 pos, inout vec3 vel, vec3 center, float radius, float hollowRadius){
    vec3 relative = pos - center;
    float dist = length(relative);
    if((dist > radius || dist < hollowRadius) && dist > 0.0001){
        vec3 normal = relative / dist;
        pos = center + normal * radius;
        vel = reflect(vel, normal);
    }
}

void confineDisc(inout vec3 pos, inout vec3 vel, vec3 center, float radius, float hollowRadius) {
    pos.y = center.y;
    vel.y = 0.0;
    vec2 relative = pos.xz - center.xz;
    float dist = length(relative);
    if ((dist > radius || dist < hollowRadius) && dist > 0.0001) {
        vec2 normal = relative / dist;
        pos.xz = center.xz + normal * radius;
        vel.xz = reflect(vel.xz, normal);
    }
}

void confineCube(inout vec3 pos, inout vec3 vel, vec3 center, float halfExtent, float hollowHalfExtent) {
    vec3 relative = pos - center;

    if (abs(relative.x) > halfExtent) {
        relative.x = sign(relative.x) * halfExtent;
        vel.x = -vel.x;
    }
    if (abs(relative.y) > halfExtent) {
        relative.y = sign(relative.y) * halfExtent;
        vel.y = -vel.y;
    }
    if (abs(relative.z) > halfExtent) {
        relative.z = sign(relative.z) * halfExtent;
        vel.z = -vel.z;
    }
    
    vec3 absRel = abs(relative);
    
    if (absRel.x < hollowHalfExtent && absRel.y < hollowHalfExtent && absRel.z < hollowHalfExtent) {
        if (absRel.x >= absRel.y && absRel.x >= absRel.z) {
            relative.x = sign(relative.x) * hollowHalfExtent;
            vel.x = -vel.x;
        } else if (absRel.y >= absRel.x && absRel.y >= absRel.z) {
            relative.y = sign(relative.y) * hollowHalfExtent;
            vel.y = -vel.y;
        } else {
            relative.z = sign(relative.z) * hollowHalfExtent;
            vel.z = -vel.z;
        }
    }
    
    pos = center + relative;
}

void main() {
    uint index = gl_GlobalInvocationID.x;
    
    if (index >= maxParticles) return;
    
    Particle p = particles[index];
    bool isImmortal = (p.flags.x == 1.0);

    if(!isImmortal){
        if (p.maxLife <= 0.0) return;
    
        if (p.life > 0.0) {
            p.position.xyz += p.velocity.xyz * config.deltaTime;
            p.velocity.y -= gravity * config.deltaTime;
            p.life -= config.deltaTime;
        
            float lifeRatio = clamp(p.life / p.maxLife, 0.0, 1.0);
            p.color = mix(config.endColor, config.startColor, lifeRatio);//fades the color from startColor to endColor
        }
    
        if (p.life <= 0.0 && p.velocity.w == 1.0) {
            p.velocity.w = 0.0; // Clear burst flag to prevent re-triggering
        
            // Allocates this index for burst spawning
            int burstCount = max(config.burstCount, 0);

            uint burstIndex = atomicAdd(burstParticlesToSpawn, uint(burstCount));
        
            if (burstIndex + uint(burstCount) <= 10000u) {
                for (int i = 0; i < burstCount; ++i) {
                    burstPositions[burstIndex + uint(i)] = vec4(p.position.xyz, 0.0);
                }
            }
        }
    
        // Release dead particles
        if (p.life <= 0.0 && p.maxLife > 0.0) {
            uint slot = atomicAdd(freeListHead, 1u);
            if(slot < maxParticles){
                freeList[slot] = int(index);
                atomicAdd(particleCount, uint(-1));
                p.maxLife = -1.0; // Mark as free
            }
            else{
                atomicAdd(freeListHead, uint(-1)); // Revert increment if out of bounds
            }
        }
    }
    else{
        if(motionEnabled != 0){
            p.position.xyz += p.velocity.xyz * config.deltaTime;

            if(config.emitterType == 2)
                confineSphere(p.position.xyz, p.velocity.xyz, config.position.xyz, config.size, hollowSize);
            
            if(config.emitterType == 3)
                confineDisc(p.position.xyz, p.velocity.xyz, config.position.xyz, config.size, hollowSize);

            if(config.emitterType == 4)
                confineCube(p.position.xyz, p.velocity.xyz, config.position.xyz, config.size, hollowSize);
        }
        if(shapeRotationEnabled){
            float angle = angularVelocity * config.deltaTime;
            float cosAngle = cos(angle);
            float sinAngle = sin(angle);
            
            vec3 pos = p.position.xyz - config.position.xyz; // Translate to origin
            vec3 rotatedPos;
            rotatedPos.x = pos.x * cosAngle - pos.z * sinAngle;
            rotatedPos.y = pos.y; // Rotation about Y-axis
            rotatedPos.z = pos.x * sinAngle + pos.z * cosAngle;
            p.position.xyz = rotatedPos + config.position.xyz; // Translate back
        }
    }
    
    particles[index] = p;
}
