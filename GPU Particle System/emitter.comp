#version 430 core
layout(local_size_x = 64) in; // Work group size, meaning each work group contains 64 threads.

struct Particle { // Particle structure
    vec4 position;  // xyz: position, w: size
    vec4 velocity;  // xyz: velocity, w: burst flag (0=no burst, 1=burst on death)
    vec4 color;     // rgba: color
    float life;     // Remaining lifetime
    float maxLife;  // Maximum lifetime
    vec2 padding;
};

struct EmitterConfig {
    vec4 position;
    vec4 direction;
    vec4 startColor;
    vec4 endColor;
    float size;
    float speed;
    float speedVariation;
    float spread;
    float particleLifetime;
    float particleLifetimeVariation;
    float spawnRate;    // particles per second
    int emitterType;    // 0 = continuous, 1 = burst
    float deltaTime;
    int burstCount;     // number of particles in a burst
    vec2 padding;
};

layout(std430, binding = 0) buffer ParticleBuffer {// Particle buffer
    Particle particles[];
};

layout(std430, binding = 1) buffer ParticleCountBuffer {
    uint particleCount; //current active particle count
    uint freeListHead; //index of the head of the free list
};

layout(std430, binding = 2) buffer FreeListBuffer {
    int freeList[];
};

layout(std430, binding = 3) buffer AccumulatorBuffer {
    float spawnAccumulator; //Accumulated time for spawning particles
};

layout(std140, binding = 0) uniform EmitterUniform {
    EmitterConfig config;
};

uniform uint maxParticles;
uniform uint frameSeed; // Seed based on frame count for randomness

const float PI = 3.14159265359;
const uint SEED_BASE = 42u;//seed for random number generation

//GPU does not have a built-in random number generator, so we implement a simple hash-based random number generator for deterministic randomness based on a seed.
//Bob Jenkin's hash-based random number generator
uint hash(uint x) {
    x += (x << 10u);
    x ^= (x >> 6u);
    x += (x << 3u);
    x ^= (x >> 11u);
    x += (x << 15u);
    return x;
}

float randomFloat(uint seed, float min, float max) {
    uint h = hash(seed);
    float random = float(h) / float(0xffffffffU); //normalize to [0,1]
    return min + random * (max - min);
}

// Cone direction for continuous emitter spread
vec3 randomConeDirection(uint seed, vec3 baseDir, float spreadDegrees) { //Here we use spherical coordinates
    float theta = randomFloat(hash(seed + 1u), 0.0, 2.0 * PI); // Random azimuthal angle
    float phi = randomFloat(hash(seed + 2u), 0.0, spreadDegrees * PI / 180.0); // Random polar angle within the spread cone
    
    vec3 offset = vec3(// Convert spherical coordinates to Cartesian coordinates
        sin(phi) * cos(theta),
        sin(phi) * sin(theta),
        cos(phi)
    );
    
    return normalize(baseDir + offset);
}

int acquire() { //This is the same as acquire in ParticlePool.cpp
    // Try to get a particle from free list
    uint prev = atomicAdd(freeListHead, uint(-1));

    if (prev == 0u || prev > maxParticles) {
        atomicAdd(freeListHead, 1u); // Restore the free list head if it was invalid
        return -1; // No free particles
    }

    atomicAdd(particleCount, 1u); // Increment active particle count
    return freeList[prev - 1u]; // Return the index of the acquired particle
}

void spawnParticle(uint particleIndex, uint seed, bool isBurst) {
    Particle p;
    p.position = vec4(config.position.xyz, config.size);
    
    // Randomize position slightly for burst emitter
    if (isBurst) {
        p.position.x += randomFloat(hash(seed + 10u), -1.0, 1.0);
        p.position.y += randomFloat(hash(seed + 11u), -0.2, 0.2);
        //p.position.z += randomFloat(hash(seed + 12u), -0.2, 0.2);
    }
    
    //Spreads in cone shape for continuous emitter
    vec3 dir = randomConeDirection(seed, config.direction.xyz, config.spread);
    float speedVariation = randomFloat(hash(seed + 20u), -config.speedVariation, config.speedVariation);
    float finalSpeed = config.speed + speedVariation;
    p.velocity = vec4(dir * finalSpeed, isBurst ? 1.0 : 0.0);
    
    p.color = config.startColor;
    
    float lifetimeVariation = randomFloat(hash(seed + 30u), -config.particleLifetimeVariation, config.particleLifetimeVariation);
    p.life = max(config.particleLifetime + lifetimeVariation, 0.001);
    p.maxLife = p.life;
    
    particles[particleIndex] = p;
}

void main() {
    uint globalIndex = gl_GlobalInvocationID.x;
    
    // Only one thread handles spawning
    if (globalIndex != 0u) return;
    
    // Update accumulator
    float accumTime = spawnAccumulator;
    accumTime += config.deltaTime;

    if(config.spawnRate <= 0.0) {
        spawnAccumulator = accumTime; // No spawning if spawnRate is zero or negative
        return;
    }

    float spawnInterval = 1.0 / config.spawnRate;
    
    // Continuous Emitter
    if (config.emitterType == 0) {
        while (accumTime >= spawnInterval) {
            int particleIndex = acquire();
            if (particleIndex == -1) break; // Pool full
            
            uint seed = hash(SEED_BASE ^ uint(particleIndex) ^ hash(frameSeed));
            spawnParticle(uint(particleIndex), seed, false);
            
            accumTime -= spawnInterval;
        } 
        spawnAccumulator = accumTime;
    }
    // Burst Emitter
    else if (config.emitterType == 1) {
        while (accumTime >= spawnInterval) {
            int particleIndex = acquire();
            if (particleIndex == -1) break;
            
            uint seed = hash(SEED_BASE ^ uint(particleIndex) ^ hash(frameSeed+1u));
            spawnParticle(uint(particleIndex), seed, true);
            
            accumTime -= spawnInterval;
        }
        spawnAccumulator = accumTime;
    }
}
